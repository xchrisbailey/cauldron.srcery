# Copy to apps/api/.env (Bun loads it automatically).

# Port the API listens on. The web dev server proxies /v1 here.
PORT=3001
# Origin the browser sees. Auth cookies and OAuth redirects use it.
PUBLIC_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Postgres connection string. When unset, the API runs PGlite (Postgres in process).
# DATABASE_URL=postgres://cauldron:cauldron@localhost:5432/cauldron
# Production (NODE_ENV=production) requires DATABASE_URL, PUBLIC_URL and a 32+ character secret,
# RESEND_API_KEY and EMAIL_FROM.
# Trust the web proxy's x-client-ip header for the client address (rate limits, auth). Only
# enable when the API is reachable through the web proxy alone.
# TRUST_PROXY=false
# Where PGlite keeps local data. Leave unset for an in-memory database.
PGLITE_DATA_DIR=.data/pglite
# OTLP/HTTP collector for traces and logs, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional local OIDC provider standing in for Google and Apple (`bun run dev:oidc`).
# DEV_OAUTH_DISCOVERY_URL=http://localhost:9400/.well-known/openid-configuration

# Email. Without RESEND_API_KEY, emails (verification, password reset) are
# printed to the API log instead, links included.
# RESEND_API_KEY=
# EMAIL_FROM=Cauldron <hello@cauldron.srcery.computer>

# Social sign-in, each enabled when both values are set.
# Google: OAuth client (web). Redirect URI: <PUBLIC_URL>/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple: Services ID and the client-secret JWT. Return URL: <PUBLIC_URL>/v1/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
